+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * OPPO Pad Mini XN254_P_D_A0040 command-mode AMOLED panel.
+ *
+ * The initialization stream and timings are generated from the panel data in
+ * the OPD2515 runtime FDT. This driver is based on the upstream NT37801 panel
+ * driver and uses the same DSC and DSI integration model.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#include <video/mipi_display.h>
+
+struct oppo_xn254 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *vddr_en_gpio;
+	struct gpio_desc *panel_en_gpio;
+	struct regulator_bulk_data *supplies;
+};
+
+static const struct regulator_bulk_data oppo_xn254_supplies[] = {
+	{ .supply = "vddio" },
+	{ .supply = "vdd" },
+	{ .supply = "vci" },
+};
+
+#include "panel-oppo-xn254-sequences.h"
+
+static inline struct oppo_xn254 *to_oppo_xn254(struct drm_panel *panel)
+{
+	return container_of(panel, struct oppo_xn254, panel);
+}
+
+static void oppo_xn254_reset(struct oppo_xn254 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(25000, 26000);
+}
+
+static void oppo_xn254_set_page(struct mipi_dsi_multi_context *dsi_ctx, u8 page)
+{
+	static const u8 force_page[] = { 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x00 };
+	u8 command[ARRAY_SIZE(force_page)];
+
+	memcpy(command, force_page, sizeof(command));
+	command[5] = page;
+	mipi_dsi_dcs_write_buffer_multi(dsi_ctx, command, sizeof(command));
+}
+
+static void oppo_xn254_send_sequence(struct mipi_dsi_multi_context *dsi_ctx,
+				     const u8 *sequence, size_t length)
+{
+	size_t offset = 0;
+
+	while (offset < length && !dsi_ctx->accum_err) {
+		u16 payload_length;
+		u8 wait;
+
+		if (offset + 7 > length) {
+			dsi_ctx->accum_err = -EINVAL;
+			return;
+		}
+
+		wait = sequence[offset + 4];
+		payload_length = (sequence[offset + 5] << 8) | sequence[offset + 6];
+		if (offset + 7 + payload_length > length) {
+			dsi_ctx->accum_err = -EINVAL;
+			return;
+		}
+
+		mipi_dsi_dcs_write_buffer_multi(dsi_ctx, &sequence[offset + 7],
+						payload_length);
+		if (wait)
+			mipi_dsi_msleep(dsi_ctx, wait);
+		offset += 7 + payload_length;
+	}
+}
+
+static int oppo_xn254_prepare(struct drm_panel *panel)
+{
+	struct oppo_xn254 *ctx = to_oppo_xn254(panel);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+	struct drm_dsc_picture_parameter_set pps;
+	u8 power_mode = 0;
+	u8 signal_mode = 0;
+	int power_ret;
+	int signal_ret;
+	int ret;
+
+	/* Runtime FDT sequence: VDDIO, VDD, PMIC GPIO4, VCI, TLMM GPIO6. */
+	ret = regulator_enable(ctx->supplies[0].consumer);
+	if (ret < 0)
+		return ret;
+	msleep(2);
+
+	ret = regulator_enable(ctx->supplies[1].consumer);
+	if (ret < 0)
+		goto err_disable_vddio;
+	msleep(15);
+
+	gpiod_set_value_cansleep(ctx->vddr_en_gpio, 1);
+	msleep(3);
+
+	ret = regulator_enable(ctx->supplies[2].consumer);
+	if (ret < 0)
+		goto err_disable_vddr;
+	msleep(15);
+
+	gpiod_set_value_cansleep(ctx->panel_en_gpio, 1);
+	msleep(3);
+	oppo_xn254_reset(ctx);
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	oppo_xn254_send_sequence(&dsi_ctx, xn254_on_sequence,
+				 sizeof(xn254_on_sequence));
+	if (dsi_ctx.accum_err)
+		goto err;
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+	oppo_xn254_set_page(&dsi_ctx, 0x00);
+	if (dsi_ctx.accum_err)
+		goto err;
+	power_ret = mipi_dsi_dcs_get_power_mode(dsi, &power_mode);
+	signal_ret = mipi_dsi_dcs_read(dsi, 0x0e, &signal_mode, 1);
+	dev_info(&dsi->dev,
+		 "OPD2515 XN254 readback power(0Ah) rc=%d val=0x%02x signal(0Eh) rc=%d val=0x%02x\n",
+		 power_ret, power_mode, signal_ret, signal_mode);
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, 0x0ffe - 0x0666);
+	if (ret < 0) {
+		dsi_ctx.accum_err = ret;
+		goto err;
+	}
+
+	msleep(28);
+	return 0;
+
+err:
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	gpiod_set_value_cansleep(ctx->panel_en_gpio, 0);
+	regulator_disable(ctx->supplies[2].consumer);
+err_disable_vddr:
+	gpiod_set_value_cansleep(ctx->vddr_en_gpio, 0);
+	regulator_disable(ctx->supplies[1].consumer);
+err_disable_vddio:
+	regulator_disable(ctx->supplies[0].consumer);
+	return dsi_ctx.accum_err ? dsi_ctx.accum_err : ret;
+}
+
+static int oppo_xn254_unprepare(struct drm_panel *panel)
+{
+	struct oppo_xn254 *ctx = to_oppo_xn254(panel);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	oppo_xn254_send_sequence(&dsi_ctx, xn254_off_sequence,
+				 sizeof(xn254_off_sequence));
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	gpiod_set_value_cansleep(ctx->panel_en_gpio, 0);
+	msleep(3);
+	regulator_disable(ctx->supplies[2].consumer);
+	msleep(3);
+	gpiod_set_value_cansleep(ctx->vddr_en_gpio, 0);
+	msleep(3);
+	regulator_disable(ctx->supplies[1].consumer);
+	msleep(3);
+	regulator_disable(ctx->supplies[0].consumer);
+	msleep(1);
+	return dsi_ctx.accum_err;
+}
+
+static const struct drm_display_mode oppo_xn254_mode = {
+	.clock = (1680 + 64 + 32 + 48) * (2520 + 136 + 8 + 24) * 120 / 1000,
+	.hdisplay = 1680,
+	.hsync_start = 1680 + 64,
+	.hsync_end = 1680 + 64 + 32,
+	.htotal = 1680 + 64 + 32 + 48,
+	.vdisplay = 2520,
+	.vsync_start = 2520 + 136,
+	.vsync_end = 2520 + 136 + 8,
+	.vtotal = 2520 + 136 + 8 + 24,
+	.width_mm = 124,
+	.height_mm = 186,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int oppo_xn254_get_modes(struct drm_panel *panel,
+				struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector,
+						    &oppo_xn254_mode);
+}
+
+static const struct drm_panel_funcs oppo_xn254_panel_funcs = {
+	.prepare = oppo_xn254_prepare,
+	.unprepare = oppo_xn254_unprepare,
+	.get_modes = oppo_xn254_get_modes,
+};
+
+static int oppo_xn254_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	oppo_xn254_set_page(&dsi_ctx, 0x00);
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+	return mipi_dsi_dcs_set_display_brightness_large(
+		dsi, 0x0ffe - backlight_get_brightness(bl));
+}
+
+static const struct backlight_ops oppo_xn254_bl_ops = {
+	.update_status = oppo_xn254_bl_update_status,
+};
+
+static struct backlight_device *
+oppo_xn254_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 0x0666,
+		.max_brightness = 0x0ffe,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &oppo_xn254_bl_ops, &props);
+}
+
+static int oppo_xn254_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct oppo_xn254 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct oppo_xn254, panel,
+				   &oppo_xn254_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev,
+					    ARRAY_SIZE(oppo_xn254_supplies),
+					    oppo_xn254_supplies,
+					    &ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset GPIO\n");
+
+	ctx->vddr_en_gpio = devm_gpiod_get(dev, "vddr-en", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->vddr_en_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->vddr_en_gpio),
+				     "Failed to get VDD regulator enable GPIO\n");
+
+	ctx->panel_en_gpio = devm_gpiod_get(dev, "panel-en", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->panel_en_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel_en_gpio),
+				     "Failed to get panel enable GPIO\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB101010;
+	dsi->mode_flags = MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS |
+			  MIPI_DSI_MODE_LPM |
+			  MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT;
+
+	ctx->panel.prepare_prev_first = true;
+	ctx->panel.backlight = oppo_xn254_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 2;
+	ctx->dsc.slice_height = 24;
+	ctx->dsc.slice_width = 840;
+	ctx->dsc.slice_count = 2;
+	ctx->dsc.bits_per_component = 10;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+	dsi->dsc = &ctx->dsc;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void oppo_xn254_remove(struct mipi_dsi_device *dsi)
+{
+	struct oppo_xn254 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id oppo_xn254_of_match[] = {
+	{ .compatible = "oppo,xn254-p-d-a0040" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, oppo_xn254_of_match);
+
+static struct mipi_dsi_driver oppo_xn254_driver = {
+	.probe = oppo_xn254_probe,
+	.remove = oppo_xn254_remove,
+	.driver = {
+		.name = "panel-oppo-xn254",
+		.of_match_table = oppo_xn254_of_match,
+	},
+};
+module_mipi_dsi_driver(oppo_xn254_driver);
+
+MODULE_AUTHOR("OPD2515 Armada OS port");
+MODULE_DESCRIPTION("OPPO Pad Mini XN254 command-mode AMOLED panel");
+MODULE_LICENSE("GPL");
