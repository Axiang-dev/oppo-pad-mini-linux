+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Persistent OPD2515 early-boot log using the on-disk UNIXNULG format.
+ *
+ * The 4 MiB window is the tail of oplusreserve5, whose final 4 MiB was
+ * verified to be zero before this logger was introduced. Nothing is written
+ * until Linux has enumerated that GPT partition. Logs produced before UFS is
+ * available stay in the static RAM buffer and are copied on the first flush.
+ */
+#include <linux/blkdev.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/kallsyms.h>
+#include <linux/kernel.h>
+#include <linux/opd2515_persist_log.h>
+#include <linux/sizes.h>
+#include <linux/stdarg.h>
+#include <linux/string.h>
+
+#define OPD_LOG_MAGIC		"UNIXNULG"
+#define OPD_LOG_VERSION		1
+#define OPD_LOG_REGION_SIZE	SZ_4M
+#define OPD_LOG_HEADER_SIZE	SZ_4K
+#define OPD_LOG_TEXT_CAP	SZ_128K
+#define OPD_LOG_PRE_SIZE	SZ_4K
+#define OPD_LOG_TARGET		"PARTLABEL=oplusreserve5"
+
+struct unixnu_log_header {
+	u8 magic[8];
+	__le32 version;
+	__le32 header_size;
+	__le32 text_capacity;
+	__le32 text_bytes;
+	__le32 sequence;
+	__le32 reserved;
+	__le64 partition_bytes;
+	__le64 region_offset;
+} __packed;
+
+static char opd_log_pre[OPD_LOG_PRE_SIZE] __initdata;
+static size_t opd_log_pre_used __initdata;
+static char opd_log_text[OPD_LOG_TEXT_CAP] __initdata;
+static size_t opd_log_used __initdata;
+static char opd_log_blob[OPD_LOG_HEADER_SIZE + OPD_LOG_TEXT_CAP]
+	__initdata __aligned(SZ_4K);
+static struct file *opd_log_file __initdata;
+static u64 opd_log_partition_bytes __initdata;
+static loff_t opd_log_region_offset __initdata;
+static u32 opd_log_sequence __initdata;
+static bool opd_log_open_failed __initdata;
+
+static size_t opd_log_append(char *dst, size_t capacity, size_t used,
+			     const char *text, size_t length)
+{
+	size_t drop;
+
+	if (length > capacity) {
+		text += length - capacity;
+		length = capacity;
+	}
+
+	if (used + length > capacity) {
+		drop = ALIGN(used + length - capacity, 256);
+		if (drop > used)
+			drop = used;
+		memmove(dst, dst + drop, used - drop);
+		used -= drop;
+	}
+
+	memcpy(dst + used, text, length);
+	return used + length;
+}
+
+static ssize_t __init opd_log_write_all(struct file *file, const void *buffer,
+					size_t length, loff_t position)
+{
+	const char *cursor = buffer;
+	size_t written = 0;
+
+	while (written < length) {
+		ssize_t result = kernel_write(file, cursor + written,
+					      length - written, &position);
+
+		if (result < 0)
+			return result;
+		if (!result)
+			return -EIO;
+		written += result;
+	}
+	return written;
+}
+
+static bool __init opd_log_open_target(void)
+{
+	struct unixnu_log_header old_header;
+	dev_t dev;
+	loff_t pos;
+	int ret;
+
+	if (opd_log_file)
+		return true;
+	if (opd_log_open_failed)
+		return false;
+
+	ret = early_lookup_bdev(OPD_LOG_TARGET, &dev);
+	if (ret)
+		return false;
+
+	opd_log_file = bdev_file_open_by_dev(dev,
+					     BLK_OPEN_READ | BLK_OPEN_WRITE,
+					     NULL, NULL);
+	if (IS_ERR(opd_log_file)) {
+		opd_log_file = NULL;
+		opd_log_open_failed = true;
+		return false;
+	}
+
+	opd_log_partition_bytes = bdev_nr_bytes(file_bdev(opd_log_file));
+	if (opd_log_partition_bytes < OPD_LOG_REGION_SIZE) {
+		fput(opd_log_file);
+		opd_log_file = NULL;
+		opd_log_open_failed = true;
+		return false;
+	}
+
+	opd_log_region_offset =
+		(loff_t)(opd_log_partition_bytes - OPD_LOG_REGION_SIZE);
+	pos = opd_log_region_offset;
+	ret = kernel_read(opd_log_file, &old_header, sizeof(old_header), &pos);
+	if (ret == sizeof(old_header) &&
+	    !memcmp(old_header.magic, OPD_LOG_MAGIC, sizeof(old_header.magic)))
+		opd_log_sequence = le32_to_cpu(old_header.sequence);
+	else
+		opd_log_sequence = 0;
+
+	if (opd_log_pre_used) {
+		opd_log_used = opd_log_append(opd_log_text, OPD_LOG_TEXT_CAP, 0,
+					      opd_log_pre, opd_log_pre_used);
+		opd_log_pre_used = 0;
+	}
+
+	opd_log_used = opd_log_append(opd_log_text, OPD_LOG_TEXT_CAP,
+				      opd_log_used,
+				      "Linux: UNIXNULG writer opened oplusreserve5\n",
+				      sizeof("Linux: UNIXNULG writer opened oplusreserve5\n") - 1);
+	return true;
+}
+
+void __init opd2515_persist_flush(void)
+{
+	struct unixnu_log_header *header;
+	size_t text_length;
+	ssize_t text_written, header_written;
+	loff_t pos;
+
+	if (!opd_log_open_target() || !opd_log_used)
+		return;
+
+	text_length = ALIGN(opd_log_used, SZ_4K);
+	if (OPD_LOG_HEADER_SIZE + text_length > sizeof(opd_log_blob))
+		return;
+	memset(opd_log_blob, 0, OPD_LOG_HEADER_SIZE + text_length);
+
+	header = (struct unixnu_log_header *)opd_log_blob;
+	memcpy(header->magic, OPD_LOG_MAGIC, sizeof(header->magic));
+	header->version = cpu_to_le32(OPD_LOG_VERSION);
+	header->header_size = cpu_to_le32(OPD_LOG_HEADER_SIZE);
+	header->text_capacity = cpu_to_le32(OPD_LOG_TEXT_CAP);
+	header->text_bytes = cpu_to_le32(opd_log_used);
+	header->sequence = cpu_to_le32(opd_log_sequence);
+	header->partition_bytes = cpu_to_le64(opd_log_partition_bytes);
+	header->region_offset = cpu_to_le64(opd_log_region_offset);
+	memcpy(opd_log_blob + OPD_LOG_HEADER_SIZE, opd_log_text, opd_log_used);
+
+	/* The 4 KiB header is the commit record: publish it only after text. */
+	pos = opd_log_region_offset + OPD_LOG_HEADER_SIZE;
+	text_written = opd_log_write_all(opd_log_file,
+					 opd_log_blob + OPD_LOG_HEADER_SIZE,
+					 text_length, pos);
+	if (text_written != text_length || vfs_fsync(opd_log_file, 1))
+		return;
+
+	pos = opd_log_region_offset;
+	header_written = opd_log_write_all(opd_log_file, opd_log_blob,
+					   OPD_LOG_HEADER_SIZE, pos);
+	if (header_written == OPD_LOG_HEADER_SIZE &&
+	    !vfs_fsync(opd_log_file, 1))
+		opd_log_sequence++;
+}
+
+void __init opd2515_persist_log(const char *fmt, ...)
+{
+	char line[192];
+	va_list args;
+	int length;
+
+	va_start(args, fmt);
+	length = vsnprintf(line, sizeof(line), fmt, args);
+	va_end(args);
+	if (length <= 0)
+		return;
+	if (length >= sizeof(line))
+		length = sizeof(line) - 1;
+
+	if (!opd_log_file) {
+		opd_log_pre_used = opd_log_append(opd_log_pre,
+						 OPD_LOG_PRE_SIZE,
+						 opd_log_pre_used,
+						 line, length);
+		return;
+	}
+
+	opd_log_used = opd_log_append(opd_log_text, OPD_LOG_TEXT_CAP,
+				      opd_log_used, line, length);
+}
+
+void __init opd2515_persist_initcall_start(unsigned int level,
+					   unsigned int index, void *fn)
+{
+	char name[96] = "unknown";
+
+	sprint_symbol_no_offset(name, (unsigned long)fn);
+	opd2515_persist_log("I L%u %u %s\n", level, index, name);
+	opd2515_persist_flush();
+}
+
+void __init opd2515_persist_initcall_end(unsigned int level,
+					 unsigned int index, void *fn, int ret)
+{
+	char name[96] = "unknown";
+
+	if (!ret)
+		return;
+	sprint_symbol_no_offset(name, (unsigned long)fn);
+	opd2515_persist_log("R L%u %u %s ret=%d\n", level, index, name, ret);
+	opd2515_persist_flush();
+}
