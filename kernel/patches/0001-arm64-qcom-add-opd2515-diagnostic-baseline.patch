+
+static bool __init overlaps(phys_addr_t start, phys_addr_t length)
+{
+	return start < OPD_SPLASH_BASE + OPD_SPLASH_SIZE &&
+		start + length > OPD_SPLASH_BASE;
+}
+
+void __init opd2515_visual_entry_probe(phys_addr_t boot_fdt)
+{
+	unsigned long address = __fix_to_virt(FIX_EARLYCON_MEM_BASE);
+	phys_addr_t page, kernel_start = __pa_symbol(_text);
+	phys_addr_t kernel_size = __pa_symbol(_end) - kernel_start;
+
+	BUILD_BUG_ON(OPD_SPLASH_BASE % PAGE_SIZE);
+	BUILD_BUG_ON(OPD_SPLASH_SIZE % PAGE_SIZE);
+	/* Refuse a changed firmware placement of the image or incoming FDT.
+	 * The arm64 incoming FDT limit is 2MiB; checking the maximum is conservative.
+	 */
+	if (overlaps(kernel_start, kernel_size) ||
+	    (boot_fdt && overlaps(boot_fdt, SZ_2M)))
+		return;
+
+#ifdef CONFIG_OPD2515_PERSISTENT_LOG
+	opd2515_persist_log("visual: entry probe at 0x%llx\n",
+			    (unsigned long long)OPD_SPLASH_BASE);
+#endif
+
+	for (page = OPD_SPLASH_BASE;
+	     page < OPD_SPLASH_BASE + OPD_SPLASH_SIZE; page += PAGE_SIZE) {
+		/* Slot is empty on entry and after each clear: break before make. */
+		__set_fixmap(FIX_EARLYCON_MEM_BASE, page, PAGE_KERNEL);
+		memset((void *)address, 0x00, PAGE_SIZE);
+		dcache_clean_poc(address, address + PAGE_SIZE);
+		__set_fixmap(FIX_EARLYCON_MEM_BASE, 0, __pgprot(0));
+	}
+	opd_visual_allowed = true;
+	opd_text_console_active = true;
+}
+
+static void __ref visual_fill_rect(phys_addr_t frame, unsigned int x,
+				  unsigned int y, unsigned int width,
+				  unsigned int height, u32 color)
+{
+	phys_addr_t start, end, page;
+	unsigned int row;
+
+	for (row = y; row < y + height; row++) {
+		start = frame + row * OPD_VISUAL_STRIDE + x * sizeof(u32);
+		end = start + width * sizeof(u32);
+		while (start < end) {
+			void *mapping;
+			unsigned int offset, length;
+
+			page = start & PAGE_MASK;
+			mapping = early_memremap(page, PAGE_SIZE);
+			if (!mapping)
+				return;
+			offset = start - page;
+			length = min_t(phys_addr_t, PAGE_SIZE - offset,
+				       end - start);
+			memset32((void *)((unsigned long)mapping + offset), color,
+				 length / sizeof(u32));
+			dcache_clean_poc((unsigned long)mapping + offset,
+					 (unsigned long)mapping + offset + length);
+			early_memunmap(mapping, PAGE_SIZE);
+			start += length;
+		}
+	}
+}
+
+static const struct opd_glyph *visual_glyph(char character)
+{
+	unsigned int index;
+
+	if (character >= 'a' && character <= 'z')
+		character -= 'a' - 'A';
+	for (index = 0; index < ARRAY_SIZE(opd_glyphs); index++) {
+		if (opd_glyphs[index].character == character)
+			return &opd_glyphs[index];
+	}
+	return &opd_glyphs[1];
+}
+
+static void __init visual_canvas_text_line(unsigned int y, const char *text)
+{
+	const unsigned int char_width = 6 * OPD_TEXT_SCALE;
+	unsigned int length = min(strlen(text), (size_t)OPD_TEXT_COLS);
+	unsigned int x = (OPD_VISUAL_WIDTH - length * char_width) / 2;
+	unsigned int glyph_index, row, column, sy, sx;
+
+	for (glyph_index = 0; glyph_index < length; glyph_index++) {
+		const struct opd_glyph *glyph = visual_glyph(text[glyph_index]);
+
+		for (row = 0; row < 7; row++) {
+			for (column = 0; column < 5; column++) {
+				if (!(glyph->row[row] & BIT(4 - column)))
+					continue;
+				for (sy = 0; sy < OPD_TEXT_SCALE; sy++) {
+					for (sx = 0; sx < OPD_TEXT_SCALE; sx++) {
+						unsigned int px = x + glyph_index * char_width +
+							column * OPD_TEXT_SCALE + sx;
+						unsigned int py = y + row * OPD_TEXT_SCALE + sy;
+
+						opd_text_canvas[py * OPD_VISUAL_WIDTH + px] =
+							0xffffffff;
+					}
+				}
+			}
+		}
+	}
+}
+
+static void __ref visual_blit_canvas(u32 *canvas, phys_addr_t frame,
+				    unsigned int y, unsigned int height)
+{
+	unsigned int row;
+
+	for (row = 0; row < height; row++) {
+		const char *source = (const char *)&canvas[row * OPD_VISUAL_WIDTH];
+		phys_addr_t address = frame + (phys_addr_t)(y + row) *
+			OPD_VISUAL_STRIDE;
+		unsigned int copied = 0;
+
+		while (copied < OPD_VISUAL_STRIDE) {
+			unsigned int offset = address & ~PAGE_MASK;
+			unsigned int length = min_t(unsigned int,
+						  PAGE_SIZE - offset,
+						  OPD_VISUAL_STRIDE - copied);
+			void *mapping = early_memremap(address & PAGE_MASK, PAGE_SIZE);
+
+			if (!mapping)
+				return;
+			memcpy((void *)((unsigned long)mapping + offset),
+			       source + copied, length);
+			dcache_clean_poc((unsigned long)mapping + offset,
+					 (unsigned long)mapping + offset + length);
+			early_memunmap(mapping, PAGE_SIZE);
+			copied += length;
+			address += length;
+		}
+	}
+}
+
+void __init opd2515_visual_text(const char *tag, const char *detail)
+{
+	if (!opd_visual_allowed ||
+	    atomic_cmpxchg_acquire(&opd_screen_rendering, 0, 1))
+		return;
+
+#ifdef CONFIG_OPD2515_PERSISTENT_LOG
+	opd2515_persist_log("visual text: %s | %s\n", tag, detail);
+#endif
+
+	if (!opd_text_console_active) {
+		visual_fill_rect(OPD_SPLASH_BASE, 0, 0,
+				 OPD_VISUAL_WIDTH, OPD_VISUAL_HEIGHT, 0xff000000);
+		opd_text_console_active = true;
+	} else {
+		visual_fill_rect(OPD_SPLASH_BASE, 0, OPD_TEXT_BAND_Y,
+				 OPD_VISUAL_WIDTH, OPD_TEXT_BAND_HEIGHT,
+				 0xff000000);
+	}
+
+	memset32(opd_text_canvas, 0xff000000, ARRAY_SIZE(opd_text_canvas));
+	visual_canvas_text_line(0, tag);
+	visual_canvas_text_line(OPD_TEXT_LINE_HEIGHT + 16, detail);
+	visual_blit_canvas(opd_text_canvas, OPD_SPLASH_BASE, OPD_TEXT_BAND_Y,
+			   OPD_TEXT_BAND_HEIGHT);
+	atomic_set_release(&opd_screen_rendering, 0);
+}
+
+static void visual_log_canvas_line(unsigned int y, const char *text)
+{
+	const unsigned int char_width = 6 * OPD_LOG_SCALE;
+	unsigned int length = min(strlen(text), (size_t)OPD_LOG_COLS);
+	unsigned int glyph_index, row, column, sy, sx;
+
+	for (glyph_index = 0; glyph_index < length; glyph_index++) {
+		const struct opd_glyph *glyph = visual_glyph(text[glyph_index]);
+
+		for (row = 0; row < 7; row++) {
+			for (column = 0; column < 5; column++) {
+				if (!(glyph->row[row] & BIT(4 - column)))
+					continue;
+				for (sy = 0; sy < OPD_LOG_SCALE; sy++) {
+					for (sx = 0; sx < OPD_LOG_SCALE; sx++) {
+						unsigned int px = 24 +
+							glyph_index * char_width +
+							column * OPD_LOG_SCALE + sx;
+						unsigned int py = y + row * OPD_LOG_SCALE + sy;
+
+						opd_log_canvas[py * OPD_VISUAL_WIDTH + px] =
+							0xffffffff;
+					}
+				}
+			}
+		}
+	}
+}
+
+/*
+ * A small fault banner uses the existing canvas and mappings. Preserve the
+ * lower log and avoid waiting for the renderer in exception context.
+ */
+void __ref opd2515_visual_fatal(const char *kind, const char *reason,
+				unsigned long code, unsigned long pc, unsigned long lr)
+{
+	const unsigned int height = 3 * OPD_LOG_LINE_HEIGHT;
+	char line[96];
+
+	if (system_state >= SYSTEM_FREEING_INITMEM || !opd_visual_allowed ||
+	    atomic_read_acquire(&opd_visual_retired) ||
+	    atomic_cmpxchg_acquire(&opd_screen_rendering, 0, 1))
+		return;
+
+	if (opd_fatal_printed)
+		goto unlock;
+
+	memset32(opd_log_canvas, 0xff000000, OPD_VISUAL_WIDTH * height);
+	snprintf(line, sizeof(line), "%s: %s", kind, reason);
+	visual_log_canvas_line(0, line);
+	if (pc || code) {
+		snprintf(line, sizeof(line), "PC %pS CODE %lX", (void *)pc, code);
+		visual_log_canvas_line(OPD_LOG_LINE_HEIGHT, line);
+		snprintf(line, sizeof(line), "LR %pS", (void *)lr);
+		visual_log_canvas_line(2 * OPD_LOG_LINE_HEIGHT, line);
+	}
+	visual_blit_canvas(opd_log_canvas, OPD_SPLASH_BASE, OPD_TEXT_BAND_Y,
+			   height);
+	opd_fatal_printed = true;
+unlock:
+	atomic_set_release(&opd_screen_rendering, 0);
+}
+
+void __ref opd2515_visual_retire(void)
+{
+	atomic_set_release(&opd_visual_retired, 1);
+
+	while (atomic_cmpxchg_acquire(&opd_screen_rendering, 0, 1))
+		cond_resched();
+
+	atomic_set_release(&opd_screen_rendering, 0);
+}
+
+void __ref opd2515_visual_log(const char *fmt, ...)
+{
+	char line[96];
+	va_list args;
+	unsigned int first, count, height, row;
+	int length;
+
+	if (system_state >= SYSTEM_FREEING_INITMEM ||
+	    atomic_read_acquire(&opd_visual_retired))
+		return;
+
+	va_start(args, fmt);
+	length = vsnprintf(line, sizeof(line), fmt, args);
+	va_end(args);
+	if (length <= 0)
+		return;
+	if (length >= sizeof(line))
+		length = sizeof(line) - 1;
+	line[length] = '\0';
+
+	/* Early callers can run before sleeping locks are available. */
+	if (atomic_cmpxchg_acquire(&opd_screen_rendering, 0, 1))
+		return;
+
+	if (atomic_read_acquire(&opd_visual_retired))
+		goto unlock;
+
+	if (opd_screen_log_count < OPD_LOG_LINES) {
+		strscpy(opd_screen_log[opd_screen_log_count], line,
+			sizeof(opd_screen_log[0]));
+		opd_screen_log_count++;
+	} else {
+		memmove(opd_screen_log[0], opd_screen_log[1],
+			(OPD_LOG_LINES - 1) * sizeof(opd_screen_log[0]));
+		strscpy(opd_screen_log[OPD_LOG_LINES - 1], line,
+			sizeof(opd_screen_log[0]));
+	}
+
+	if (!opd_visual_allowed)
+		goto unlock;
+	if (!opd_text_console_active) {
+		visual_fill_rect(OPD_SPLASH_BASE, 0, 0,
+				 OPD_VISUAL_WIDTH, OPD_VISUAL_HEIGHT, 0xff000000);
+		opd_text_console_active = true;
+	}
+
+	first = opd_screen_log_count > OPD_LOG_VISIBLE ?
+		opd_screen_log_count - OPD_LOG_VISIBLE : 0;
+	count = min(opd_screen_log_count - first, OPD_LOG_VISIBLE);
+	height = count * OPD_LOG_LINE_HEIGHT;
+	visual_fill_rect(OPD_SPLASH_BASE, 0, OPD_LOG_BAND_Y,
+			 OPD_VISUAL_WIDTH, height, 0xff000000);
+	memset32(opd_log_canvas, 0xff000000,
+		 OPD_VISUAL_WIDTH * height);
+	for (row = 0; row < count; row++)
+		visual_log_canvas_line(row * OPD_LOG_LINE_HEIGHT,
+				       opd_screen_log[first + row]);
+	visual_blit_canvas(opd_log_canvas, OPD_SPLASH_BASE, OPD_LOG_BAND_Y,
+			   height);
+unlock:
+	atomic_set_release(&opd_screen_rendering, 0);
+}
+
+void __init opd2515_visual_mark(unsigned int stage)
+{
+#ifdef CONFIG_OPD2515_PERSISTENT_LOG
+	opd2515_persist_log("visual mark: %u\n", stage);
+#endif
+	opd2515_visual_log("STAGE %u", stage);
+}
+
+void __init opd2515_visual_mark_plain(unsigned int stage)
+{
+#ifdef CONFIG_OPD2515_PERSISTENT_LOG
+	opd2515_persist_log("visual plain: %u\n", stage);
+#endif
+	opd2515_visual_log("STAGE %u", stage);
+}
