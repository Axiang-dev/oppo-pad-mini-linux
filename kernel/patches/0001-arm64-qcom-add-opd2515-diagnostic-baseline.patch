+// SPDX-License-Identifier: GPL-2.0-only
+/* Temporary OPD2515 diagnostic console. No peripheral register access.
+ * The first 4 KiB of the original console's verified reserved RAM is reused.
+ * Remaining console/pmsg RAM is untouched until standard ramoops takes over.
+ */
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/types.h>
+#include <asm/cacheflush.h>
+#include <asm/fixmap.h>
+#include <asm/memory.h>
+#include <asm/sections.h>
+#include "opd2515_early_ring.h"
+
+#define OPD_CONSOLE_PHYS 0xaffdbf000ULL
+static struct opd_early_ring *opd_ring;
+static bool opd_active;
+void __init opd2515_early_log_start(void);
+void opd2515_early_log_stop(phys_addr_t address);
+void opd2515_early_log_flush_restart(void);
+
+static void opd_console_write(struct console *con, const char *s,
+			      unsigned int count)
+{
+	if (!opd_active)
+		return;
+	opd_ring_write(opd_ring, s, count);
+	/* Complete writes and clean the whole page to RAM before a reset. */
+	dsb(ishst);
+	dcache_clean_poc((unsigned long)opd_ring,
+			 (unsigned long)opd_ring + sizeof(*opd_ring));
+}
+
+static struct console opd_console = {
+	.name = "opdram",
+	.write = opd_console_write,
+	.flags = CON_BOOT | CON_PRINTBUFFER,
+	.index = -1,
+};
+
+void __init opd2515_early_log_start(void)
+{
+	BUILD_BUG_ON(sizeof(struct opd_early_ring) != PAGE_SIZE);
+	/* Refuse to overwrite the image if firmware changes its load placement. */
+	if (OPD_CONSOLE_PHYS < __pa_symbol(_end) &&
+	    OPD_CONSOLE_PHYS + PAGE_SIZE > __pa_symbol(_text))
+		return;
+	/* Dedicated early-console slot: stable across paging_init, unlike BTMAP. */
+	__set_fixmap(FIX_EARLYCON_MEM_BASE, OPD_CONSOLE_PHYS, PAGE_KERNEL);
+	opd_ring = (void *)__fix_to_virt(FIX_EARLYCON_MEM_BASE);
+	opd_ring_reset(opd_ring);
+	opd_active = true;
+	register_console(&opd_console);
+	pr_notice("OPD2515-DIAG2: setup_arch reached, early RAM console active\n");
+}
+
+/* Called before ramoops maps or resets the same physical console buffer. */
+void opd2515_early_log_stop(phys_addr_t address)
+{
+	if (address != OPD_CONSOLE_PHYS || !opd_active)
+		return;
+	pr_notice("OPD2515-DIAG2: handing early console to standard ramoops\n");
+	unregister_console(&opd_console);
+	opd_active = false;
+	dcache_clean_inval_poc((unsigned long)opd_ring,
+			       (unsigned long)opd_ring + sizeof(*opd_ring));
+	__set_fixmap(FIX_EARLYCON_MEM_BASE, 0, __pgprot(0));
+}
+
+/* Invoked after interrupts/other CPUs stop, immediately before firmware reset.
+ * Unlike a normal cached ramoops mapping, this explicitly reaches RAM.
+ */
+void opd2515_early_log_flush_restart(void)
+{
+	unsigned long base = __fix_to_virt(FIX_EARLYCON_MEM_BASE);
+	phys_addr_t addr;
+
+	if (opd_active) {
+		dcache_clean_poc(base, base + PAGE_SIZE);
+		return;
+	}
+	for (addr = OPD_CONSOLE_PHYS; addr < OPD_CONSOLE_PHYS + 0x40000;
+	     addr += PAGE_SIZE) {
+		/* Break before make: this slot changes physical page each time. */
+		__set_fixmap(FIX_EARLYCON_MEM_BASE, 0, __pgprot(0));
+		__set_fixmap(FIX_EARLYCON_MEM_BASE, addr, PAGE_KERNEL);
+		dcache_clean_poc(base, base + PAGE_SIZE);
+	}
+	__set_fixmap(FIX_EARLYCON_MEM_BASE, 0, __pgprot(0));
+}
--- /dev/null
+++ b/arch/arm64/kernel/opd2515_early_ring.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Ramoops-compatible, single-console writer. Layout: ram_core.c, GPL-2.0. */
+struct opd_early_ring {
+	u32 signature;
+	u32 start;
+	u32 size;
+	u8 data[4096 - 12];
+};
+
+static void opd_ring_reset(struct opd_early_ring *ring)
+{
+	ring->signature = 0x43474244;
+	ring->start = 0;
+	ring->size = 0;
+}
+
+static void opd_ring_write(struct opd_early_ring *ring, const char *text,
+			   unsigned int length)
+{
+	const unsigned int capacity = sizeof(ring->data);
+	unsigned int i, start = ring->start, size = ring->size;
+
+	for (i = 0; i < length; i++) {
+		ring->data[start++] = text[i];
+		if (start == capacity)
+			start = 0;
+		if (size < capacity)
+			size++;
+	}
+	ring->start = start;
+	ring->size = size;
+}
