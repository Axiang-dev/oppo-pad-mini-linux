+// SPDX-License-Identifier: BSD-3-Clause
+/* OPD2515 bootstrap: SoC support is upstream Molokai; board data is collected locally. */
+/dts-v1/;
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/spmi/spmi.h>
+#include <dt-bindings/gpio/gpio.h>
+#include "molokai.dtsi"
+
+/ {
+    model = "OPPO Pad Mini OPD2515 (USB diagnostic)";
+    compatible = "oppo,opd2515", "qcom,molokai";
+    chassis-type = "tablet";
+    chosen { };
+    /* Clock glue follows the upstream Molokai board; frequencies come from OPPO FDT. */
+    clocks {
+        bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
+            compatible = "fixed-factor-clock";
+            #clock-cells = <0>;
+            clocks = <&rpmhcc RPMH_CXO_CLK_A>;
+            clock-mult = <1>;
+            clock-div = <2>;
+        };
+        bi_tcxo_div2: bi-tcxo-div2-clk {
+            compatible = "fixed-factor-clock";
+            #clock-cells = <0>;
+            clocks = <&rpmhcc RPMH_CXO_CLK>;
+            clock-mult = <1>;
+            clock-div = <2>;
+        };
+        sleep_clk: sleep-clk {
+            compatible = "fixed-clock";
+            clock-frequency = <32000>;
+            #clock-cells = <0>;
+        };
+        xo_board: xo-board {
+            compatible = "fixed-clock";
+            clock-frequency = <76800000>;
+            #clock-cells = <0>;
+        };
+    };
+
+    reboot-mode {
+        compatible = "nvmem-reboot-mode";
+        nvmem-cells = <&oppo_reboot_reason>;
+        nvmem-cell-names = "reboot-mode";
+        /* Verified in OPPO qcom-reboot-reason.c, not inferred from another board. */
+        mode-normal = <0x3e>;
+        mode-recovery = <0x01>;
+        mode-bootloader = <0x02>;
+    };
+};
+
+&apps_rsc {
+    regulators-b {
+        compatible = "qcom,pm8550-rpmh-regulators";
+        qcom,pmic-id = "B_E0";
+        vreg_l10b_disp_1p8: ldo10 {
+            regulator-name = "opd2515-panel-vddio-1p8";
+            regulator-min-microvolt = <1800000>;
+            regulator-max-microvolt = <1800000>;
+            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+            regulator-allow-set-load;
+        };
+        vreg_l12b_disp_1p2: ldo12 {
+            regulator-name = "opd2515-panel-vdd-1p2";
+            regulator-min-microvolt = <1200000>;
+            regulator-max-microvolt = <1200000>;
+            regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
