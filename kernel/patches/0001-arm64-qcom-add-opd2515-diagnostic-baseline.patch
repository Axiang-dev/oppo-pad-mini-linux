+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Local fail-closed memory handoff for the built-in diagnostic tree.
+ * Built-in FDT integration derives from Joonhoe Kim's Freedom patch 21/56.
+ * This helper is also compiled unchanged into the host validation harness.
+ */
+static int opd2515_fdt_memory(void *dst, const void *src, int capacity)
+{
+	int node, target, len, count = 0, i, err, positive;
+	const void *reg;
+	const char *type, *status;
+	unsigned long long addr, size;
+	const fdt32_t *words;
+
+	if (!src || fdt_check_header(src) || fdt_check_header(dst))
+		return -FDT_ERR_BADMAGIC;
+	/* The OPPO source and our tree both use 64-bit addresses and sizes. */
+	if (fdt_address_cells(src, 0) != 2 || fdt_size_cells(src, 0) != 2 ||
+	    fdt_address_cells(dst, 0) != 2 || fdt_size_cells(dst, 0) != 2)
+		return -FDT_ERR_BADNCELLS;
+	err = fdt_open_into(dst, dst, capacity);
+	if (err)
+		return err;
+	/* Remove placeholders, including memory@... nodes, before importing RAM. */
+	for (;;) {
+		target = -1;
+		fdt_for_each_subnode(node, dst, 0) {
+			type = fdt_getprop(dst, node, "device_type", &len);
+			if (type && len == 7 && !memcmp(type, "memory", 7)) {
+				target = node;
+				break;
+			}
+		}
+		if (target < 0)
+			break;
+		err = fdt_del_node(dst, target);
+		if (err)
+			return err;
+	}
+	fdt_for_each_subnode(node, src, 0) {
+		type = fdt_getprop(src, node, "device_type", &len);
+		if (!type || len != 7 || memcmp(type, "memory", 7))
+			continue;
+		status = fdt_getprop(src, node, "status", &len);
+		if (status && !((len == 5 && !memcmp(status, "okay", 5)) ||
+				(len == 3 && !memcmp(status, "ok", 3))))
+			continue;
+		reg = fdt_getprop(src, node, "reg", &len);
+		if (!reg || len <= 0 || len % 16)
+			return -FDT_ERR_BADVALUE;
+		words = reg;
+		positive = 0;
+		for (i = 0; i < len / 4; i += 4) {
+			addr = ((unsigned long long)fdt32_to_cpu(words[i]) << 32) |
+				fdt32_to_cpu(words[i + 1]);
+			size = ((unsigned long long)fdt32_to_cpu(words[i + 2]) << 32) |
+				fdt32_to_cpu(words[i + 3]);
+			positive += !!size;
+			if (addr + size < addr || (addr & 4095) || (size & 4095))
+				return -FDT_ERR_BADVALUE;
+		}
+		if (!positive)
+			return -FDT_ERR_BADVALUE;
+		target = fdt_add_subnode(dst, 0, fdt_get_name(src, node, 0));
+		if (target < 0)
+			return target;
+		err = fdt_setprop(dst, target, "device_type", "memory", 7);
+		if (!err)
+			err = fdt_setprop(dst, target, "reg", reg, len);
+		if (err)
+			return err;
+		count++;
+	}
+	if (!count)
+		return -FDT_ERR_NOTFOUND;
+	/* Retain bootloader reservations, never its initrd, bootargs or drivers. */
+	count = fdt_num_mem_rsv(src);
+	if (count < 0)
+		return count;
+	for (i = 0; i < count; i++) {
+		uint64_t raddr, rsize;
+		err = fdt_get_mem_rsv(src, i, &raddr, &rsize);
+		if (err || !rsize || raddr + rsize < raddr)
+			return -FDT_ERR_BADVALUE;
+		err = fdt_add_mem_rsv(dst, raddr, rsize);
+		if (err)
+			return err;
+	}
+	return 0;
+}
