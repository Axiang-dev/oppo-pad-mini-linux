OPD2515: add command-mode DSI MISR diagnostics

Enable the downstream command-mode MISR on DSI0 for OPD2515 and expose the
command MDP0 signature through the existing register snapshot. The diagnostic
is limited to command mode and preserves the other MISR control bits.

Reference: OPPO Pad Mini R3 ffca906674b2,
dsi_ctrl_hw_cmn_setup_misr().

diff --git a/drivers/gpu/drm/msm/registers/display/dsi.xml b/drivers/gpu/drm/msm/registers/display/dsi.xml
--- a/drivers/gpu/drm/msm/registers/display/dsi.xml
+++ b/drivers/gpu/drm/msm/registers/display/dsi.xml
@@ -261,6 +261,10 @@
 		<bitfield name="TX_EOT_APPEND" pos="0" type="boolean"/>
 		<bitfield name="RX_EOT_IGNORE" pos="4" type="boolean"/>
 	</reg32>
+	<reg32 offset="0x0009c" name="MISR_CMD_CTRL">
+		<bitfield name="ENABLE" pos="28" type="boolean"/>
+	</reg32>
+	<reg32 offset="0x00130" name="MISR_CMD_MDP0_32BIT"/>
 	<reg32 offset="0x000a4" name="LANE_STATUS">
 		<bitfield name="DLN0_STOPSTATE" pos="0" type="boolean"/>
 		<bitfield name="DLN1_STOPSTATE" pos="1" type="boolean"/>
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -802,8 +802,25 @@
 	}
 }
 
+static void dsi_cmd_misr_set(struct msm_dsi_host *msm_host, bool enable)
+{
+	u32 control;
+
+	if (msm_host->id || (msm_host->mode_flags & MIPI_DSI_MODE_VIDEO) ||
+	    !of_machine_is_compatible("oppo,opd2515"))
+		return;
+
+	control = dsi_read(msm_host, REG_DSI_MISR_CMD_CTRL);
+	if (enable)
+		control |= DSI_MISR_CMD_CTRL_ENABLE;
+	else
+		control &= ~DSI_MISR_CMD_CTRL_ENABLE;
+	dsi_write(msm_host, REG_DSI_MISR_CMD_CTRL, control);
+}
+
 static void dsi_ctrl_disable(struct msm_dsi_host *msm_host)
 {
+	dsi_cmd_misr_set(msm_host, false);
 	dsi_write(msm_host, REG_DSI_CTRL, 0);
 }
 
@@ -943,6 +960,8 @@
 
 	if (msm_host->cphy_mode)
 		dsi_write(msm_host, REG_DSI_CPHY_MODE_CTRL, BIT(0));
+
+	dsi_cmd_misr_set(msm_host, true);
 }
 
 static void dsi_update_dsc_timing(struct msm_dsi_host *msm_host, bool is_cmd_mode)
