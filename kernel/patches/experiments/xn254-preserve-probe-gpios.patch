Preserve inherited GPIO direction and outputs during passive XN254 bind.

diff --git a/drivers/gpu/drm/panel/panel-oppo-xn254.c b/drivers/gpu/drm/panel/panel-oppo-xn254.c
--- a/drivers/gpu/drm/panel/panel-oppo-xn254.c
+++ b/drivers/gpu/drm/panel/panel-oppo-xn254.c
@@ -93,6 +93,10 @@
 		offset += 7 + payload_length;
 	}
 }
+
+static bool preserve_splash_gpios;
+module_param(preserve_splash_gpios, bool, 0400);
+MODULE_PARM_DESC(preserve_splash_gpios, "Preserve GPIO direction and levels during passive splash diagnosis");
 
 static int oppo_xn254_prepare(struct drm_panel *panel)
 {
@@ -105,6 +109,10 @@
 	int power_ret;
 	int signal_ret;
 	int ret;
+
+	/* With the diagnostic option the GPIO direction is deliberately untouched. */
+	if (preserve_splash_gpios)
+		return -EOPNOTSUPP;
 
 	/* Runtime FDT sequence: VDDIO, VDD, PMIC GPIO4, VCI, TLMM GPIO6. */
 	ret = regulator_enable(ctx->supplies[0].consumer);
@@ -253,6 +261,7 @@
 {
 	struct device *dev = &dsi->dev;
 	struct oppo_xn254 *ctx;
+	enum gpiod_flags gpio_flags = preserve_splash_gpios ? GPIOD_ASIS : GPIOD_OUT_LOW;
 	int ret;
 
 	ctx = devm_drm_panel_alloc(dev, struct oppo_xn254, panel,
@@ -268,20 +277,26 @@
 	if (ret < 0)
 		return ret;
 
-	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", gpio_flags);
 	if (IS_ERR(ctx->reset_gpio))
 		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
 				     "Failed to get reset GPIO\n");
 
-	ctx->vddr_en_gpio = devm_gpiod_get(dev, "vddr-en", GPIOD_OUT_LOW);
+	ctx->vddr_en_gpio = devm_gpiod_get(dev, "vddr-en", gpio_flags);
 	if (IS_ERR(ctx->vddr_en_gpio))
 		return dev_err_probe(dev, PTR_ERR(ctx->vddr_en_gpio),
 				     "Failed to get VDD regulator enable GPIO\n");
 
-	ctx->panel_en_gpio = devm_gpiod_get(dev, "panel-en", GPIOD_OUT_LOW);
+	ctx->panel_en_gpio = devm_gpiod_get(dev, "panel-en", gpio_flags);
 	if (IS_ERR(ctx->panel_en_gpio))
 		return dev_err_probe(dev, PTR_ERR(ctx->panel_en_gpio),
 				     "Failed to get panel enable GPIO\n");
+
+	if (preserve_splash_gpios)
+		dev_info(dev, "OPD2515 XN254 preserved GPIO raw reset=%d vddr-en=%d panel-en=%d\n",
+			 gpiod_get_raw_value_cansleep(ctx->reset_gpio),
+			 gpiod_get_raw_value_cansleep(ctx->vddr_en_gpio),
+			 gpiod_get_raw_value_cansleep(ctx->panel_en_gpio));
 
 	ctx->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, ctx);
